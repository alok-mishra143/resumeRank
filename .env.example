# Copy to .env. Every value here is optional: with an empty file the CLI runs
# fully offline against local JSON storage.

# Data directory (default ~/.resumerank). All state lives here as JSON.
RESUMERANK_HOME=~/.resumerank

# TypeSafe Jev (System One) — optional typed-extraction/verification layer.
# Get a key at https://console.typesafe.ai. No key => offline mode.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_KEEP_THRESHOLD=0.5
TYPESAFE_FIRE_THRESHOLD=0.7
TYPESAFE_SKILL_LEVEL_MIN=1.5

# Ranking tuning
RANKING_CANDIDATE_LIMIT=50
RANKING_FINAL_LIMIT=20
RANKING_DETERMINISTIC_WEIGHT=0.7
RANKING_MISMATCH_THRESHOLD=0.4
RANKING_HARD_FLOOR=0.15
SEMANTIC_DESCENDANT_CREDIT=0.8
EXTRACT_OFFLINE_KEEP=0.58
EXTRACT_PROPOSE_FLOOR=0.45

# 1 = never touch the network, even with a key set.
RESUMERANK_OFFLINE=0
